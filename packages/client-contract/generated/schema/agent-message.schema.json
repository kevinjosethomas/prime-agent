{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentMessage",
  "description": "Conversation message stored in `message` entries: the provider-facing\nmessages from [`crate::ai`] plus the coding-agent-only roles.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "const": "user"
        }
      },
      "$ref": "#/$defs/UserMessage",
      "required": [
        "role"
      ]
    },
    {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "const": "assistant"
        }
      },
      "$ref": "#/$defs/AssistantMessage",
      "required": [
        "role"
      ]
    },
    {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "const": "toolResult"
        }
      },
      "$ref": "#/$defs/ToolResultMessage",
      "required": [
        "role"
      ]
    },
    {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "const": "bashExecution"
        }
      },
      "$ref": "#/$defs/BashExecutionMessage",
      "required": [
        "role"
      ]
    },
    {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "const": "custom"
        }
      },
      "$ref": "#/$defs/CustomMessage",
      "required": [
        "role"
      ]
    },
    {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "const": "branchSummary"
        }
      },
      "$ref": "#/$defs/BranchSummaryMessage",
      "required": [
        "role"
      ]
    },
    {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "const": "compactionSummary"
        }
      },
      "$ref": "#/$defs/CompactionSummaryMessage",
      "required": [
        "role"
      ]
    }
  ],
  "$defs": {
    "UserContent": {
      "description": "User/tool-result content: a plain string or a list of text/image blocks.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UserContentBlock"
          }
        }
      ]
    },
    "UserContentBlock": {
      "description": "Content blocks in user/tool-result messages: a `text` block, an `image` block, or any other JSON shape (unknown kinds preserved verbatim).",
      "anyOf": [
        {
          "properties": {
            "type": {
              "const": "text"
            }
          },
          "required": [
            "type"
          ],
          "$ref": "#/$defs/TextContent"
        },
        {
          "properties": {
            "type": {
              "const": "image"
            }
          },
          "required": [
            "type"
          ],
          "$ref": "#/$defs/ImageContent"
        },
        {
          "not": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "text"
                  }
                },
                "required": [
                  "type"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "image"
                  }
                },
                "required": [
                  "type"
                ]
              }
            ]
          }
        }
      ]
    },
    "TextContent": {
      "description": "Text content block (`type: \"text\"`).",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "textSignature": {
          "description": "`OpenAI` Responses metadata: a legacy id string or a [`TextSignatureV1`] JSON payload (TS\nwire key `textSignature`; the camelCase rename keeps it attached across the pa-ai <->\npa-agent round trips, which have no catch-all).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": true
    },
    "ImageContent": {
      "description": "Image content block (`type: \"image\"`); data is base64.",
      "type": "object",
      "properties": {
        "data": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        }
      },
      "required": [
        "data",
        "mimeType"
      ],
      "additionalProperties": true
    },
    "UserMessage": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/UserContent"
        },
        "timestamp": {
          "description": "Unix timestamp in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "content",
        "timestamp"
      ],
      "additionalProperties": true
    },
    "AssistantContentBlock": {
      "description": "Content blocks allowed in assistant messages.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "$ref": "#/$defs/TextContent",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "thinking"
            }
          },
          "$ref": "#/$defs/ThinkingContent",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "toolCall"
            }
          },
          "$ref": "#/$defs/ToolCall",
          "required": [
            "type"
          ]
        }
      ]
    },
    "ThinkingContent": {
      "description": "Thinking content block (`type: \"thinking\"`).",
      "type": "object",
      "properties": {
        "thinking": {
          "type": "string"
        },
        "thinkingSignature": {
          "description": "Provider reasoning item id, or the encoded reasoning-details payload for redacted blocks (TS\nwire key `thinkingSignature`; the camelCase rename keeps it attached across the pa-ai <->\npa-agent round trips, where a `snake_case` key was silently dropped).",
          "type": [
            "string",
            "null"
          ]
        },
        "redacted": {
          "description": "True when the thinking content was redacted by safety filters.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "thinking"
      ],
      "additionalProperties": true
    },
    "ToolCall": {
      "description": "Tool call content block (`type: \"toolCall\"`).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": true
        },
        "thoughtSignature": {
          "description": "Google-specific opaque signature for reusing thought context (TS\nwire key `thoughtSignature`; see [`ThinkingContent`] for the rename).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "arguments"
      ],
      "additionalProperties": true
    },
    "AssistantMessageDiagnostic": {
      "description": "One redacted provider/runtime diagnostic attached to an assistant message.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "timestamp": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagnosticErrorInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "details": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "type",
        "timestamp"
      ]
    },
    "DiagnosticErrorInfo": {
      "description": "Error info captured inside a diagnostic.",
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "stack": {
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "description": "TS `string | number`.",
          "anyOf": [
            {
              "$ref": "#/$defs/DiagnosticCode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": true
    },
    "DiagnosticCode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/JsNumber"
        }
      ]
    },
    "JsNumber": {
      "description": "An f64 that (de)serializes with JavaScript `JSON.stringify` number parity. TypeScript numbers\nare\nf64 and `JSON.stringify` prints integral values without a fractional part (`0`, not `0.0`);\nRust's `f64` serialization always prints `0.0`, which would break lossless round-trips against\nTS-produced files. This newtype prints integral values as integers, everything else via the\nshortest f64 representation.",
      "type": "number",
      "format": "double"
    },
    "Usage": {
      "type": "object",
      "properties": {
        "input": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cacheRead": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cacheWrite": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "totalTokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cost": {
          "$ref": "#/$defs/UsageCost"
        }
      },
      "required": [
        "input",
        "output",
        "cacheRead",
        "cacheWrite",
        "totalTokens",
        "cost"
      ]
    },
    "UsageCost": {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/JsNumber"
        },
        "output": {
          "$ref": "#/$defs/JsNumber"
        },
        "cacheRead": {
          "$ref": "#/$defs/JsNumber"
        },
        "cacheWrite": {
          "$ref": "#/$defs/JsNumber"
        },
        "total": {
          "$ref": "#/$defs/JsNumber"
        }
      },
      "required": [
        "input",
        "output",
        "cacheRead",
        "cacheWrite",
        "total"
      ]
    },
    "StopReason": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "stop",
            "length",
            "error",
            "aborted"
          ]
        },
        {
          "description": "Terminal reason of a turn that ended in tool calls; also accepts the\nraw `OpenAI` wire value `tool_calls` (TS keeps any `stopReason`\nstring, so foreign session files never lose assistant rows).",
          "type": "string",
          "const": "toolUse"
        }
      ]
    },
    "AssistantMessage": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssistantContentBlock"
          }
        },
        "api": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "responseModel": {
          "description": "Concrete `chunk.model` when different from the requested model.",
          "type": [
            "string",
            "null"
          ]
        },
        "responseId": {
          "description": "Provider-specific response identifier, when exposed upstream.",
          "type": [
            "string",
            "null"
          ]
        },
        "diagnostics": {
          "description": "Redacted provider/runtime diagnostics for failures and recoveries.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/AssistantMessageDiagnostic"
          }
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "stopReason": {
          "$ref": "#/$defs/StopReason"
        },
        "stopReasonRaw": {
          "description": "Provider's raw stop/finish reason when it mapped to `\"error\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "errorMessage": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "description": "Unix timestamp in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "content",
        "api",
        "provider",
        "model",
        "usage",
        "stopReason",
        "timestamp"
      ],
      "additionalProperties": true
    },
    "ToolResultMessage": {
      "type": "object",
      "properties": {
        "toolCallId": {
          "type": "string"
        },
        "toolName": {
          "description": "The tool's name. A session file from a foreign tool or older build\nmay omit it (the TS loader keeps such rows), so the field defaults;\nan empty name is not re-serialized, keeping it lossless.",
          "type": "string"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UserContentBlock"
          }
        },
        "details": {
          "description": "Structured details for logs or UI rendering."
        },
        "isError": {
          "type": "boolean"
        },
        "timestamp": {
          "description": "Unix timestamp in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "toolCallId",
        "content",
        "isError",
        "timestamp"
      ],
      "additionalProperties": true
    },
    "BashExecutionMessage": {
      "description": "`role: \"bashExecution\"`: a `!`-command execution, rendered as a user turn.",
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "exitCode": {
          "description": "Exit status; absent while the command is still running.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "cancelled": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "fullOutputPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "description": "Unix timestamp in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "excludeFromContext": {
          "description": "True excludes this message from LLM context (`!!` prefix).",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "command",
        "output",
        "cancelled",
        "truncated",
        "timestamp"
      ]
    },
    "CustomMessage": {
      "description": "`role: \"custom\"`: bookkeeping message with a `customType` tag.",
      "type": "object",
      "properties": {
        "customType": {
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/UserContent"
        },
        "display": {
          "type": "boolean"
        },
        "details": true,
        "timestamp": {
          "description": "Unix timestamp in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "customType",
        "content",
        "display",
        "timestamp"
      ],
      "additionalProperties": true
    },
    "BranchSummaryMessage": {
      "description": "`role: \"branchSummary\"`: summary of a branch the conversation returned from.",
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "fromId": {
          "type": "string"
        },
        "timestamp": {
          "description": "Unix timestamp in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "summary",
        "fromId",
        "timestamp"
      ]
    },
    "CompactionSummaryMessage": {
      "description": "`role: \"compactionSummary\"`: compaction result presented as a user turn.",
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "tokensBefore": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "retainedMessageCount": {
          "description": "Retained messages that precede this summary in transcript presentation.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "customInstructions": {
          "description": "User instructions that guided the summary (`/compact <instructions>`).",
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "description": "Unix timestamp in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "summary",
        "tokensBefore",
        "timestamp"
      ]
    }
  }
}
