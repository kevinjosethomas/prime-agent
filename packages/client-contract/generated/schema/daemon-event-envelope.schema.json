        {
          "$ref": "#/$defs/JsNumber"
        }
      ]
    },
    "JsNumber": {
      "description": "An f64 that (de)serializes with JavaScript `JSON.stringify` number parity. TypeScript numbers\nare\nf64 and `JSON.stringify` prints integral values without a fractional part (`0`, not `0.0`);\nRust's `f64` serialization always prints `0.0`, which would break lossless round-trips against\nTS-produced files. This newtype prints integral values as integers, everything else via the\nshortest f64 representation.",
      "type": "number",
      "format": "double"
    },
    "Usage": {
      "type": "object",
      "properties": {
        "input": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cacheRead": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cacheWrite": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "totalTokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cost": {
          "$ref": "#/$defs/UsageCost"
        }
      },
      "required": [
        "input",
        "output",
        "cacheRead",
        "cacheWrite",
        "totalTokens",
        "cost"
      ]
    },
    "UsageCost": {
      "type": "object",
      "properties": {
        "input": {
