          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "content",
        "timestamp"
      ],
      "additionalProperties": true
    },
    "AssistantContentBlock": {
      "description": "Content blocks allowed in assistant messages.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "$ref": "#/$defs/TextContent",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "thinking"
            }
          },
          "$ref": "#/$defs/ThinkingContent",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "toolCall"
            }
          },
          "$ref": "#/$defs/ToolCall",
          "required": [
            "type"
          ]
        }
      ]
    },
    "TextContent": {
      "description": "Text content block (`type: \"text\"`).",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "textSignature": {
          "description": "`OpenAI` Responses metadata: a legacy id string or a [`TextSignatureV1`] JSON payload (TS\nwire key `textSignature`; the camelCase rename keeps it attached across the pa-ai <->\npa-agent round trips, which have no catch-all).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": true
    },
    "ThinkingContent": {
      "description": "Thinking content block (`type: \"thinking\"`).",
      "type": "object",
      "properties": {
        "thinking": {
          "type": "string"
        },
        "thinkingSignature": {
          "description": "Provider reasoning item id, or the encoded reasoning-details payload for redacted blocks (TS\nwire key `thinkingSignature`; the camelCase rename keeps it attached across the pa-ai <->\npa-agent round trips, where a `snake_case` key was silently dropped).",
          "type": [
            "string",
            "null"
          ]
        },
        "redacted": {
          "description": "True when the thinking content was redacted by safety filters.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "thinking"
      ],
      "additionalProperties": true
    },
    "ToolCall": {
      "description": "Tool call content block (`type: \"toolCall\"`).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": true
        },
        "thoughtSignature": {
          "description": "Google-specific opaque signature for reusing thought context (TS\nwire key `thoughtSignature`; see [`ThinkingContent`] for the rename).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "arguments"
      ],
      "additionalProperties": true
    },
