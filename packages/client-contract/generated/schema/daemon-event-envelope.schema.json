{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DaemonEventEnvelope",
  "description": "`type: \"event\"` envelope wrapping a [`DaemonOutbound`].",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "protocol": {
      "$ref": "#/$defs/DaemonProtocolInfo"
    },
    "activeSessionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "sequence": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/DaemonEventCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "emittedAt": {
      "type": "string"
    },
    "event": {
      "$ref": "#/$defs/DaemonOutbound"
    }
  },
  "required": [
    "id",
    "protocol",
    "emittedAt",
    "event"
  ],
  "$defs": {
    "DaemonProtocolInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "DaemonEventCursor": {
      "type": "object",
      "properties": {
        "generation": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "generation",
        "sequence"
      ]
    },
    "DaemonOutbound": {
      "description": "Supervisor -> client frames, tagged by `type`.",
      "oneOf": [
        {
          "description": "`type: \"response\"`: success or failure outcome of one command.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "response"
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "command": {
              "type": "string"
            },
            "success": {
              "type": "boolean"
            },
            "data": true,
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "errorInfo": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/DaemonErrorInfo"
                },
                {
                  "type": "object",
                  "required": [
                    "code"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "not": {
                        "enum": [
                          "missing_session_cwd",
                          "session_import_file_not_found",
                          "session_already_active",
                          "session_recovering",
                          "update_restarting",
                          "command_result_uncertain",
                          "update_prepare_refused",
                          "model_provider_unauthenticated",
                          "worker_overloaded"
                        ]
                      }
                    }
                  },
                  "additionalProperties": true
                }
              ]
            }
          },
          "required": [
            "type",
            "command",
            "success"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_list_progress"
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "command": {
              "type": "string"
            },
            "activeSessionId": {
              "type": [
                "string",
                "null"
              ]
            },
            "loaded": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "command",
            "loaded",
            "total"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_list_item"
            },
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "command": {
              "type": "string"
            },
            "activeSessionId": {
              "type": [
                "string",
                "null"
              ]
            },
            "session": {
              "$ref": "#/$defs/DaemonSavedSessionInfo"
            }
          },
          "required": [
            "type",
            "command",
            "session"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "daemon_hello"
            },
            "socketPath": {
              "type": "string"
            },
            "protocol": {
              "$ref": "#/$defs/DaemonProtocolInfo"
            },
            "schemaId": {
              "type": [
                "string",
                "null"
              ]
            },
            "schemaRevision": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "appVersion": {
              "type": [
                "string",
                "null"
              ]
            },
            "runtime": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DaemonRuntimeIdentity"
                },
                {
                  "type": "null"
                }
              ]
            },
            "supervisorGeneration": {
              "type": [
                "string",
                "null"
              ]
            },
            "supervisorPid": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "supervisorOwnerToken": {
              "type": [
                "string",
                "null"
              ]
            },
            "supervisorProcessStartId": {
              "type": [
                "string",
                "null"
              ]
            },
            "supervisorSocketPath": {
              "type": [
                "string",
                "null"
              ]
            },
            "updateResume": {
              "description": "The update resume contract (spec §10.3): whether the restore pass has finished, so a\nreconnecting client knows whether to queue its attach. Rust-only extension.",
              "anyOf": [
                {
                  "$ref": "#/$defs/DaemonUpdateResume"
                },
                {
                  "type": "null"
                }
              ]
            },
            "clientId": {
              "type": "string"
            },
            "serverCapabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "socketPath",
            "protocol",
            "clientId",
            "serverCapabilities"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "daemon_closing"
            },
            "reason": {
              "$ref": "#/$defs/DaemonClosingReason"
            }
          },
          "required": [
            "type",
            "reason"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "heartbeats_changed"
            }
          },
          "additionalProperties": true,
          "required": [
            "type"
          ]
        },
        {
          "description": "The Rust-only no-stall picker-open extension: a background catalog refresh changed the\nserved\nsnapshot, so every client re-fetches (same shape as `model_catalog_changed`).",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "model_catalog_changed"
            }
          },
          "additionalProperties": true,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "roster_update"
            },
            "changed": true,
            "removed": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "resync": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "changed"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_event"
            },
            "activeSessionId": {
              "type": "string"
            },
            "event": true,
            "meta": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DaemonEventMeta"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "activeSessionId",
            "event"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "side_question_event"
            },
            "activeSessionId": {
              "type": "string"
            },
            "event": true
          },
          "required": [
            "type",
            "activeSessionId",
            "event"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_replaced"
            },
            "activeSessionId": {
              "type": "string"
            },
            "state": true,
            "messages": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AgentMessage"
              }
            },
            "snapshotFollows": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "meta": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DaemonEventMeta"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "activeSessionId",
            "state",
            "messages"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_resynced"
            },
            "activeSessionId": {
              "type": "string"
            },
            "snapshot": {
              "$ref": "#/$defs/DaemonSessionSnapshot"
            },
            "meta": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DaemonEventMeta"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "activeSessionId",
            "snapshot"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_attached"
            },
            "activeSessionId": {
              "type": "string"
            },
            "state": true,
            "messages": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AgentMessage"
              }
            },
            "snapshot": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DaemonSessionSnapshot"
                },
                {
                  "type": "null"
                }
              ]
            },
            "replay": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DaemonReplayInfo"
                },
                {
                  "type": "null"
                }
              ]
            },
            "lastEventSequence": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "activeSessionId",
            "state",
            "messages"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_snapshot_begin"
            },
            "activeSessionId": {
              "type": "string"
            },
            "snapshotId": {
              "type": "string"
            },
            "messageCount": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "targetChunkBytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "purpose": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SnapshotPurpose"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "activeSessionId",
            "snapshotId",
            "messageCount",
            "targetChunkBytes"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_snapshot_chunk"
            },
            "activeSessionId": {
              "type": "string"
            },
            "snapshotId": {
              "type": "string"
            },
            "index": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "messages": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AgentMessage"
              }
            }
          },
          "required": [
            "type",
            "activeSessionId",
            "snapshotId",
            "index",
            "messages"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_snapshot_end"
            },
            "activeSessionId": {
              "type": "string"
            },
            "snapshotId": {
              "type": "string"
            },
            "chunkCount": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "lastEventSequence": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "lastEventCursor": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DaemonEventCursor"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "activeSessionId",
            "snapshotId",
            "chunkCount",
            "lastEventSequence"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_snapshot_failed"
            },
            "activeSessionId": {
              "type": "string"
            },
            "snapshotId": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "activeSessionId",
            "snapshotId",
            "error"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_detached"
            },
            "activeSessionId": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "activeSessionId"
          ],
          "additionalProperties": true
        },
        {
          "description": "The stale-id rebind notice (Rust-only): a worker replacement rebound a session; attached\nclients re-attach to the session's current id so their event routing follows it.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_binding"
            },
            "previousActiveSessionId": {
              "type": "string"
            },
            "activeSessionId": {
              "type": "string"
            },
            "sessionId": {
              "type": [
                "string",
                "null"
              ]
            },
            "sessionFile": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "previousActiveSessionId",
            "activeSessionId"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_closed"
            },
            "activeSessionId": {
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/DaemonSessionClosedReason"
            },
            "meta": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DaemonEventMeta"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "activeSessionId",
            "reason"
          ],
          "additionalProperties": true
        }
      ]
    },
    "DaemonErrorInfo": {
      "description": "Structured failure info carried on error responses, tagged by `code`.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "missing_session_cwd"
            },
            "issue": true
          },
          "required": [
            "code",
            "issue"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "session_import_file_not_found"
            },
            "filePath": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "filePath"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "session_already_active"
            },
            "sessionPath": {
              "type": "string"
            },
            "activeSessionId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "code",
            "sessionPath"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "session_recovering"
            },
            "activeSessionId": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "activeSessionId"
          ]
        },
        {
          "description": "The daemon is preparing an update restart: mutating commands are refused while the\ncoordinator drains and checkpoints; a transient state - clients wait and retry, never a hard\nfailure.",
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "update_restarting"
            }
          },
          "required": [
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "command_result_uncertain"
            },
            "clientId": {
              "type": "string"
            },
            "commandId": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "clientId",
            "commandId"
          ]
        },
        {
          "description": "`prepare_update_restart` with a different `updateId` while a prepare\ntransaction is active: a typed refusal the coordinator maps to `Join`.",
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "update_prepare_refused"
            },
            "activeUpdateId": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "activeUpdateId"
          ]
        },
        {
          "description": "`set_model` resolved the model but its provider has no credential: a sign-in refusal, not a\ndead end - the client offers the provider's sign-in flow and retries after the login lands.",
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "model_provider_unauthenticated"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "provider"
          ]
        },
        {
          "description": "The supervisor refused a request-shaped client command because the target worker is at its\nin-flight bound: the request never left the supervisor, so a retry cannot duplicate it.",
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "worker_overloaded"
            }
          },
          "required": [
            "code"
          ]
        },
        {
          "description": "A `code` this build does not know (a newer daemon's typed refusal):\ndegrade to the plain refusal message riding the same response, never\nfail the deserialization (that would drop the refusal).",
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "code"
          ]
        }
      ]
    },
    "DaemonSavedSessionInfo": {
      "description": "Saved-session row pushed by `session_list_item` progress events.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": true,
        "parentSessionPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "rlmDepth": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "created": {
          "type": "string"
        },
        "modified": {
          "type": "string"
        },
        "messageCount": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "firstMessage": {
          "type": "string"
        },
        "allMessagesText": {
          "type": "string"
        },
        "usage": true,
        "model": true
      },
      "required": [
        "path",
        "id",
        "cwd",
        "created",
        "modified",
        "messageCount",
        "firstMessage",
        "allMessagesText"
      ],
      "additionalProperties": true
    },
    "DaemonRuntimeIdentity": {
      "description": "Process identity of the daemon build, published in `daemon_hello`.",
      "type": "object",
      "properties": {
        "buildId": {
          "type": "string"
        },
        "executablePath": {
          "type": "string"
        },
        "entrypointPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "launcherPath": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "buildId",
        "executablePath"
      ]
    },
    "DaemonUpdateResume": {
      "description": "The successor supervisor's hello resume contract (spec §10.3): whether\nthe restore pass has finished. `update_id` is `None` on a normal boot.\nRust-only extension (the TS close frame carries no resume contract).",
      "type": "object",
      "properties": {
        "updateId": {
          "anyOf": [
            {
              "$ref": "#/$defs/UpdateId"
            },
            {
              "type": "null"
            }
          ]
        },
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "complete"
      ]
    },
    "UpdateId": {
      "description": "Opaque update identifier (a `UUIDv7` in practice), typed so status records, artifact paths, and\nprepare transactions cannot mix it up with session ids.",
      "type": "string"
    },
    "DaemonClosingReason": {
      "type": "string",
      "enum": [
        "shutdown",
        "update"
      ]
    },
    "DaemonEventMeta": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/DaemonProtocolInfo"
        },
        "activeSessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sequence": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/DaemonEventCursor"
            },
            {
              "type": "null"
            }
          ]
        },
