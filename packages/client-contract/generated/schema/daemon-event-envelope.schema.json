        },
        "output": {
          "$ref": "#/$defs/JsNumber"
        },
        "cacheRead": {
          "$ref": "#/$defs/JsNumber"
        },
        "cacheWrite": {
          "$ref": "#/$defs/JsNumber"
        },
        "total": {
          "$ref": "#/$defs/JsNumber"
        }
      },
      "required": [
        "input",
        "output",
        "cacheRead",
        "cacheWrite",
        "total"
      ]
    },
