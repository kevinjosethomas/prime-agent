          "description": "Fingerprint of the harness state behind `harness_digest`; lets cold\nboundaries skip re-delivery (TS #2400).",
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "description": "Unix timestamp in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
