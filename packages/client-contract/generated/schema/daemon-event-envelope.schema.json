    "UserContent": {
      "description": "User/tool-result content: a plain string or a list of text/image blocks.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UserContentBlock"
          }
        }
      ]
    },
    "UserContentBlock": {
      "description": "Content blocks in user/tool-result messages: a `text` block, an `image` block, or any other JSON shape (unknown kinds preserved verbatim).",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            },
            "textSignature": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "image"
            },
            "data": {
              "type": "string"
            },
            "mimeType": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "data",
            "mimeType"
          ],
          "additionalProperties": true
        },
        {}
      ]
    },
    "UserMessage": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/UserContent"
        },
        "timestamp": {
          "description": "Unix timestamp in milliseconds.",
