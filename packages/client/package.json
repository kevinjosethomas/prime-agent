{
  "name": "prime-agent-client",
  "version": "0.10.0",
  "private": true,
  "description": "Prime Agent daemon client for Node 22 / Electron 44 main-process hosts: loader, provenance verification, and typed errors over the native addon.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "native",
    "provenance.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gen:provenance": "node scripts/gen-provenance.mjs",
    "test": "npm run build && node --test tests/"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "prime-agent-client-contract": "file:../client-contract"
  }
}
